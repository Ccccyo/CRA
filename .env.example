# app
NEXT_PUBLIC_APP_URL = "http://localhost:3100"
NEXT_PUBLIC_APP_NAME = "CRA Agent Workbench"
NEXT_PUBLIC_APP_DESCRIPTION = "AI 企业信用评审工作台"
NEXT_PUBLIC_DEFAULT_LOCALE = "zh"
NEXT_PUBLIC_CRA_API_URL = "/api/cra"
CRA_API_INTERNAL_URL = "http://127.0.0.1:8001"
CRA_API_SHARED_SECRET = ""

# enterprise file storage (local for development, r2 for production)
FILE_STORAGE_BACKEND = "local"
FILE_STORAGE_ACCOUNT_ID = ""
FILE_STORAGE_BUCKET = ""
FILE_STORAGE_REGION = "auto"
FILE_STORAGE_ENDPOINT = ""
FILE_STORAGE_ACCESS_KEY_ID = ""
FILE_STORAGE_SECRET_ACCESS_KEY = ""
FILE_UPLOAD_URL_TTL_SECONDS = "300"
FILE_DOWNLOAD_URL_TTL_SECONDS = "300"

# theme
NEXT_PUBLIC_THEME = "default"

# appearance
NEXT_PUBLIC_APPEARANCE = "light"

# database
DATABASE_PROVIDER = "postgresql"
DATABASE_URL = ""
DB_SINGLETON_ENABLED = "true"
DB_MAX_CONNECTIONS = "5"

# auth secret
# openssl rand -base64 32
AUTH_SECRET = ""
INITIAL_ROLE_ENABLED = "false"
# model
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
CHAT_MODEL="deepseek-chat"
REASONER_MODEL="deepseek-reasoner"
EMBED_MODEL="BAAI/bge-m3"
RERANK_MODEL="BAAI/bge-reranker-v2-m3"
RAG_USE_VECTOR="true"
RAG_USE_RERANK="true"
CRA_ENABLE_GLEIF_MCP="false" # opt-in: exact LEI read-only lookup; never auto-match BP
CRA_DEMO_KB_RELEASE_ID="" # set CRA-DEMO-2026-10-24 only for mock-case demo rollout
OCR_BACKEND="auto" # auto/local paddle/glm; use paddle_api only after approving OCR service data transfer
PADDLE_OCR_API_URL="" # self-hosted PaddleOCR 3.x serving endpoint, e.g. http://127.0.0.1:8080/ocr
PADDLE_OCR_API_TOKEN="" # optional bearer token for a protected deployment; never expose to browser

